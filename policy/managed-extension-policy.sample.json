{
  "3rdparty": {
    "extensions": {
      "<EXTENSION_ID>": {
        "policy": {
          "enabled": true,
          "allowedOrigins": [
            "https://workspaces.grdc.com.au",
            "https://workspaces.test.grdc.com.au",
            "https://workspaces.dev.grdc.com.au"
          ],
          "allowedPathPrefixes": [
            "/"
          ],
          "openMode": "edit",
          "resolveDocShareLinks": true,
          "debug": false
        }
      }
    }
  }
}
